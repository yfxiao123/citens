# Copy to .env and fill in. All fields are optional except the LLM key.

# --- LLM backend ---------------------------------------------------------
# LLM_PROVIDER=openai  -> OpenAI-compatible (OpenAI / DeepSeek / Ollama /
#                         OpenRouter / vLLM / Groq). Set LLM_API_BASE if needed.
# LLM_PROVIDER=litellm -> native multi-provider (needs: pip install 'citens[multi]')
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here
# LLM_API_BASE=https://api.deepseek.com/v1   # for DeepSeek / OpenRouter / vLLM / ...

# Examples:
#   DeepSeek:  LLM_MODEL=deepseek-chat   LLM_API_BASE=https://api.deepseek.com/v1
#   Ollama:    LLM_MODEL=qwen2.5:7b      LLM_API_BASE=http://localhost:11434/v1
#   OpenRouter:LLM_MODEL=anthropic/claude-3.5-sonnet  LLM_API_BASE=https://openrouter.ai/api/v1

# Two-tier models: cheap stages (planner/filter/extract) use LLM_MODEL; the
# intelligence-heavy stages (writer/synth/verifier) use LLM_MODEL_STRONG.
# Empty = same model everywhere. Same LLM_API_BASE/key applies to both tiers.
# LLM_MODEL_STRONG=deepseek-v4
# Parallel LLM calls (filter/extract/verify/write sections). 1 = sequential.
# 6 is safe; 12-16 shortens big runs (-n 50+) a lot if your provider's rate
# limits allow (DeepSeek usually does). Per-run override: citens run -c 12.
# LLM_CONCURRENCY=6

# --- Speed / quality knobs ------------------------------------------------
# Deliberation (thinking) for judge-side structured calls (verify/defense/
# rewrite/audit/organize). OFF by default: on hybrid reasoning models the
# thinking prefix shares the completion budget with the body and made verify
# 3-4x slower with no precision gain (golden-set validated). true restores.
# JUDGE_THINKING=false
# Supplementary retrieval rounds after the first compose (deep used to run 2;
# each extra round is a full recompose incl. re-verification, ~20+ min).
# REFLECT_MAX_ROUNDS=1

# --- Search sources ------------------------------------------------------
# Built-in: arxiv, semantic_scholar, openalex, crossref
SEARCH_SOURCES=arxiv,semantic_scholar,openalex,crossref
# Semantic Scholar key tier: x-api-key header, 1 request/second CUMULATIVE
# across all endpoints (citens throttles all S2 calls to match)
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
CROSSREF_EMAIL=              # polite pool (free, no key)

# --- Access layer: declare what YOU can reach ----------------------------
# Empty = public web only. Fill these to reach paywalled content (campus
# EZproxy / VPN / local proxy) and institutional APIs.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# Domains you have access to (routed via the proxy); empty = proxy all:
# ACCESSIBLE_DOMAINS=sciencedirect.com,springer.com,ieeexplore.ieee.org
# Campus EZproxy prefix — paywalled URLs get rewritten to
#   {EZPROXY_PREFIX}<urlencoded target>
# so fetches ride your library session. Find it in a proxified link from your
# library page, e.g.:
# EZPROXY_PREFIX=https://lib.univ.edu.cn/login?url=
# Drop folder for PDFs you download yourself (see a run's fetch_list.md);
# checked BEFORE any network fetch:
# PAPERS_DIR=papers
SPRINGER_API_KEY=
ELSEVIER_API_KEY=
IEEE_API_KEY=

# --- Run defaults (overridable via CLI) ----------------------------------
DEFAULT_MAX_RESULTS=60
DEFAULT_MAX_PAPERS=20
# Supporting-reference layer: filtered-relevant papers beyond the core cap
# join the bibliography as abstract-only citations (0 = off)
DEFAULT_SUPPORT_PAPERS=15

# Review output language ("en" or "zh"): controls the prose language AND the
# section headings, so a run is uniformly one language.
REVIEW_LANGUAGE=en

# --- API server (only if you run the web UI) -----------------------------
# Bearer token for /run,/clarify,/runs,/result. Empty = no auth (localhost
# dev). SET THIS before exposing the server: /run spends your LLM credits.
API_TOKEN=
# Allowed CORS origins, comma-separated (empty = no CORS middleware).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

CACHE_ENABLED=true
