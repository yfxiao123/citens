# Copy to .env and fill in. All fields are optional except the LLM key.

# --- LLM backend ---------------------------------------------------------
# LLM_PROVIDER=openai  -> OpenAI-compatible (OpenAI / DeepSeek / Ollama /
#                         OpenRouter / vLLM / Groq). Set LLM_API_BASE if needed.
# LLM_PROVIDER=litellm -> native multi-provider (needs: pip install 'litreview[multi]')
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here
# LLM_API_BASE=https://api.deepseek.com/v1   # for DeepSeek / OpenRouter / vLLM / ...

# Examples:
#   DeepSeek:  LLM_MODEL=deepseek-chat   LLM_API_BASE=https://api.deepseek.com/v1
#   Ollama:    LLM_MODEL=qwen2.5:7b      LLM_API_BASE=http://localhost:11434/v1
#   OpenRouter:LLM_MODEL=anthropic/claude-3.5-sonnet  LLM_API_BASE=https://openrouter.ai/api/v1

# --- Search sources ------------------------------------------------------
# Built-in: arxiv, semantic_scholar, openalex, crossref
SEARCH_SOURCES=arxiv,semantic_scholar,openalex,crossref
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
CROSSREF_EMAIL=              # polite pool (free, no key)

# --- Access layer: declare what YOU can reach ----------------------------
# Empty = public web only. Fill these to reach paywalled content (campus
# EZproxy / VPN / local proxy) and institutional APIs.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# Domains you have access to (routed via the proxy); empty = proxy all:
# ACCESSIBLE_DOMAINS=sciencedirect.com,springer.com,ieeexplore.ieee.org
SPRINGER_API_KEY=
ELSEVIER_API_KEY=
IEEE_API_KEY=

# --- Run defaults (overridable via CLI) ----------------------------------
DEFAULT_MAX_RESULTS=60
DEFAULT_MAX_PAPERS=15

CACHE_ENABLED=true
